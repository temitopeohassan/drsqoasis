# AI assistant configuration — read by public/api/chat.php (server side only).
# Copy this file to .env and fill in the values. Never commit .env.
#
# Where .env must live:
#   - Locally: the project root (next to package.json).
#   - On the server: the folder ABOVE the web root, e.g. /home/<user>/.env when
#     the site is in /home/<user>/public_html. That keeps it out of public reach.

# --- Claude ---
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Where chat emails go ---
# Leads and issues both go to CHAT_FORWARD_TO unless the specific ones are set.
# Separate several addresses with commas.
CHAT_FORWARD_TO=info@drsqoasis.com
CHAT_LEADS_TO=
CHAT_ISSUES_TO=

# --- Sending email ---
# The From address should be on the site's own domain so mail isn't flagged as spam.
MAIL_FROM=no-reply@drsqoasis.com
MAIL_FROM_NAME=DRSQ Oasis Assistant

# Leave SMTP_HOST empty to use the server's built-in PHP mail().
# For more reliable delivery, fill in your mailbox's SMTP settings
# (from your host's cPanel "Email Accounts" > "Connect Devices").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls (port 587), ssl (port 465) or none
SMTP_SECURE=tls

# --- Conversation storage ---
# Folder where each chat's history is saved (one file per chat). Must be
# writable by PHP and outside the web root. Defaults to a chat-data folder next
# to this .env file.
CHAT_DATA_DIR=
